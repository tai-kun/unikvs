{
  "name": "unikvs",
  "version": "0.0.17",
  "description": "A modular and portable KVS client implemented in TypeScript.",
  "homepage": "https://tai-kun.github.io/unikvs/",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/tai-kun/unikvs",
    "directory": "unikvs"
  },
  "files": [
    "dist",
    "src",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vp -C .config pack"
  },
  "dependencies": {
    "@tai-kun/valibot-extra-lab": "^0.0.5",
    "@unikvs/core": "workspace:*",
    "abort-signal-utils": "^0.0.6",
    "asyncmux": "^0.0.12",
    "call-fn-once": "^0.0.12",
    "maypromise": "^0.0.4",
    "try-capture-stack-trace": "^0.0.3"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@rolldown/plugin-babel": "^0.2.4",
    "@unikvs/allow-repair": "workspace:*",
    "@unikvs/checksum": "workspace:*",
    "@unikvs/compression": "workspace:*",
    "@unikvs/fs.node": "workspace:*",
    "@unikvs/memory": "workspace:*",
    "@unikvs/opfs": "workspace:*",
    "@unikvs/testing": "workspace:*",
    "@unikvs/utils": "workspace:*",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "playwright": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@logtape/logtape": "^2.0.0",
    "valibot": "^1.0.0"
  },
  "readme": "README.md"
}
