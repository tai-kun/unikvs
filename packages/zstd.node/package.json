{
  "name": "@unikvs/zstd.node",
  "version": "0.0.14",
  "description": "Transformer plugin that compresses and decompresses byte arrays with Zstandard via node:zlib. Node.js-only.",
  "homepage": "https://tai-kun.github.io/unikvs/",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/tai-kun/unikvs",
    "directory": "packages/zstd.node"
  },
  "files": [
    "dist",
    "src",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    }
  },
  "scripts": {
    "build": "vp -C .config pack"
  },
  "dependencies": {
    "@unikvs/core": "workspace:*",
    "@unikvs/utils": "workspace:*",
    "abort-signal-utils": "^0.0.6",
    "call-fn-once": "^0.0.12",
    "inspect-lite": "^0.0.2"
  },
  "devDependencies": {
    "@unikvs/testing": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "valibot": "1.5.0",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@logtape/logtape": "^2.0.0"
  },
  "readme": "README.md"
}
