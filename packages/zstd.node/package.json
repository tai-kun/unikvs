{
  "name": "@unikvs/zstd.node",
  "version": "0.0.1",
  "description": "Transformer plugin that compresses and decompresses byte arrays with Zstandard via node:zlib. Node.js-only.",
  "homepage": "https://github.com/tai-kun/unikvs",
  "license": "MIT",
  "author": "tai-kun",
  "repository": {
    "url": "https://github.com/tai-kun/unikvs"
  },
  "files": [
    "dist",
    "src",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./errors": {
      "types": "./dist/src/errors.d.ts",
      "default": "./dist/src/errors.js"
    }
  },
  "scripts": {
    "build": "tsc --project ./.config/tsconfig.build.json"
  },
  "dependencies": {
    "@unikvs/core": "workspace:*",
    "call-fn-once": "0.0.6",
    "inspect-lite": "0.0.2"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.5",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "4.1.11",
    "npm-check-updates": "20.0.2",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@logtape/logtape": "2.0.0"
  }
}
