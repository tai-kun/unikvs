{
  "name": "@unikvs/checksum",
  "version": "0.0.18",
  "description": "Transformer plugin that transparently computes hashes of byte arrays and verifies them against expected values.",
  "homepage": "https://tai-kun.github.io/unikvs/",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/tai-kun/unikvs",
    "directory": "packages/checksum"
  },
  "files": [
    "dist",
    "src",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./checksum": {
      "types": "./dist/checksum.d.ts",
      "default": "./dist/checksum.js"
    },
    "./md5": {
      "types": "./dist/md5.d.ts",
      "default": "./dist/md5.js"
    },
    "./sha1": {
      "types": "./dist/sha1.d.ts",
      "default": "./dist/sha1.js"
    },
    "./sha224": {
      "types": "./dist/sha224.d.ts",
      "default": "./dist/sha224.js"
    },
    "./sha256": {
      "types": "./dist/sha256.d.ts",
      "default": "./dist/sha256.js"
    },
    "./sha384": {
      "types": "./dist/sha384.d.ts",
      "default": "./dist/sha384.js"
    },
    "./sha512": {
      "types": "./dist/sha512.d.ts",
      "default": "./dist/sha512.js"
    }
  },
  "scripts": {
    "build": "vp -C .config pack"
  },
  "dependencies": {
    "@unikvs/core": "workspace:*",
    "@unikvs/utils": "workspace:*",
    "inspect-lite": "^0.0.2"
  },
  "devDependencies": {
    "@unikvs/testing": "workspace:*",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "playwright": "catalog:",
    "valibot": "1.5.0",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@logtape/logtape": "^2.0.0",
    "@noble/hashes": "^2.0.0"
  },
  "readme": "README.md"
}
