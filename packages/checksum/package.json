{
  "name": "@unikvs/checksum",
  "version": "0.0.13",
  "description": "Transformer plugin that transparently computes hashes of byte arrays and verifies them against expected values.",
  "homepage": "https://github.com/tai-kun/unikvs",
  "license": "MIT",
  "author": "tai-kun",
  "repository": {
    "url": "https://github.com/tai-kun/unikvs"
  },
  "files": [
    "dist",
    "src",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./errors": {
      "types": "./dist/src/errors.d.ts",
      "default": "./dist/src/errors.js"
    },
    "./checksum": {
      "types": "./dist/src/checksum.d.ts",
      "default": "./dist/src/checksum.js"
    },
    "./md5": {
      "types": "./dist/src/md5.d.ts",
      "default": "./dist/src/md5.js"
    },
    "./sha1": {
      "types": "./dist/src/sha1.d.ts",
      "default": "./dist/src/sha1.js"
    },
    "./sha224": {
      "types": "./dist/src/sha224.d.ts",
      "default": "./dist/src/sha224.js"
    },
    "./sha256": {
      "types": "./dist/src/sha256.d.ts",
      "default": "./dist/src/sha256.js"
    },
    "./sha384": {
      "types": "./dist/src/sha384.d.ts",
      "default": "./dist/src/sha384.js"
    },
    "./sha512": {
      "types": "./dist/src/sha512.d.ts",
      "default": "./dist/src/sha512.js"
    }
  },
  "scripts": {
    "build": "tsc --project ./.config/tsconfig.build.json"
  },
  "dependencies": {
    "@unikvs/core": "workspace:*",
    "@unikvs/utils": "workspace:*",
    "inspect-lite": "0.0.2"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.5",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.13.6",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-istanbul": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "npm-check-updates": "20.0.2",
    "playwright": "1.63.0",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@logtape/logtape": "2.0.0",
    "@noble/hashes": "2.0.0"
  }
}
