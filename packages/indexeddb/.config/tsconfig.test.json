{
  "extends": ["@tsconfig/strictest"],
  "include": ["./global.d.ts", "../tests/**/*"],
  "compilerOptions": {
    "types": ["vite-plus/client"],
    "lib": ["DOM", "ESNext"],
    "noEmit": true,
    "target": "es2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "erasableSyntaxOnly": true
  }
}
