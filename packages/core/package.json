{
  "name": "@unikvs/core",
  "version": "0.0.0",
  "description": "プラグインを含む全パッケージで共有して使用されるコアパッケージです。",
  "homepage": "https://github.com/tai-kun/unikvs",
  "license": "MIT",
  "author": "tai-kun",
  "repository": {
    "url": "https://github.com/tai-kun/unikvs"
  },
  "files": [
    "dist",
    "src",
    "package.json",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./storage": {
      "types": "./dist/src/storage.types.d.ts",
      "default": "./dist/src/storage.types.js"
    },
    "./transformer": {
      "types": "./dist/src/transformer.types.d.ts",
      "default": "./dist/src/transformer.types.js"
    }
  },
  "scripts": {
    "build": "tsc --project ./.config/tsconfig.build.json"
  },
  "dependencies": {
    "i18n-error-base": "0.0.7",
    "maypromise": "0.0.4"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.5",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.13.3",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "npm-check-updates": "20.0.2",
    "playwright": "1.62.1",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@logtape/logtape": "2.0.0",
    "valibot": "1.0.0"
  }
}
